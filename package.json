{
  "name": "devops-whc-workspace",
  "version": "1.1.0",
  "description": "WHC cPanel automation CLI for deploy, verify, and rollback flows",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "whc": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts/start-whc.cjs",
    "scripts/prepare-first-time.cjs",
    "README.md",
    "AGENT_USAGE.md",
    "WHC_REQUIREMENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:dev": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "prepack": "npm run build",
    "publish:prepare": "node scripts/prepare-publish-package.cjs",
    "publish:npm": "node scripts/publish-publish-package.cjs",
    "pack:check": "node scripts/pack-publish-package.cjs",
    "pack:check:root": "npm pack --dry-run",
    "dev": "tsx src/index.ts",
    "probe": "tsx src/index.ts --probe",
    "check:generic": "tsx src/index.ts --check-generic",
    "check:health": "tsx src/index.ts --check-health",
    "help": "tsx src/index.ts --help",
    "serve": "tsx src/index.ts --serve",
    "start": "node scripts/start-whc.cjs",
    "prepare": "node scripts/prepare-first-time.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
