# Canonical template matching .env structure.
# Keep secrets out of this file.

WHC_API_TOKEN=your_api_token_here
WHC_USER=your_cpanel_username
WHC_HOST=your.cpanel.host

# Workflow mode: managed_clone_sync
WHC_WORKFLOW_MODE=managed_clone_sync

# Domain metadata for managed WordPress environments
WHC_PRIMARY_DOMAIN=your-primary-domain.example.com
WHC_TESTING_DOMAIN=your-testing-domain.example.com
WHC_STAGING_DOMAIN=your-staging-domain.example.com

# Target paths discovered from SSH/cPanel
WHC_PROD_PATH=/home/your_prod_user/public_html
WHC_STAGING_PATH=/home/your_staging_user/public_html

# Generic project source profile (provider-agnostic)
# Supports different project shapes instead of assuming one WordPress layout.
# Source kind: full_site | partial_content | package_only | artifact_first | monorepo_slice
WHC_SOURCE_KIND=full_site
# Deploy unit: raw_source | build_artifact | package_bundle
WHC_DEPLOY_UNIT=raw_source
# Release intent default: refresh | deploy | promote | migrate | recover
WHC_DEFAULT_RELEASE_INTENT=deploy
# Optional local source hints
# WHC_LOCAL_PROJECT_ROOT=D:/Source/your-project
# WHC_LOCAL_APP_PATH=apps/site
# WHC_BUILD_COMMAND=npm run build
# WHC_BUILD_ARTIFACT_PATH=dist

# Safety gates for staging-to-live operations
WHC_REQUIRE_STAGING_CONFIRM=true
WHC_WARN_DYNAMIC_DATA_SYNC=true

# Optional explicit SSH targets per environment
WHC_PROD_SSH_HOST=your-prod-ssh-host
WHC_PROD_SSH_PORT=27
WHC_PROD_SSH_USERNAME=your_prod_ssh_user
WHC_PROD_SSH_PRIVATE_KEY_PATH="C:/Users/YourName/.ssh/id_rsa_test_nopass"

WHC_STAGING_SSH_HOST=your-staging-ssh-host
WHC_STAGING_SSH_PORT=27
WHC_STAGING_SSH_USERNAME=your_staging_ssh_user
# Omit WHC_STAGING_SSH_PRIVATE_KEY_PATH when using password auth for staging.
# WHC_STAGING_SSH_PRIVATE_KEY_PATH="C:/Users/YourName/.ssh/id_rsa_test_nopass"
# Optional external/manual usage only (not consumed by current tool-server code):
# WHC_STAGING_SSH_PASSWORD=your_staging_ssh_password
# WHC_STAGING_SSH_HOSTKEY=SHA256:your_staging_hostkey_fingerprint

WHC_API_TIMEOUT_MS=15000
WHC_SSH_TIMEOUT_MS=10000
