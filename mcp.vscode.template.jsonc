{
  "servers": {
    "whc-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "devops-whc", "--serve"],
      "env": {
        "WHC_ENV_FILE": "${workspaceFolder}/.env",
        "WHC_LOCAL_PROJECT_ROOT": "${workspaceFolder}",
        "WHC_STATE_ROOT": ".mcp/whc-mcp",
        "WHC_MCP_INSTANCE_NAME": "whc-mcp"
      }
    }
  }
}
